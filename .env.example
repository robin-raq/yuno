# Goose runtime — native provider required (CLI-bridge providers won't emit tool_call events)
GOOSE_PROVIDER=anthropic
GOOSE_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=sk-ant-replace-me
GOOSE_PORT=3284

# Telegram (required for S3 — not needed for S1/S2)
TELEGRAM_BOT_TOKEN=replace-me
DEMO_TELEGRAM_CHAT_ID=replace-me

# Application
DATABASE_URL=sqlite+aiosqlite:///./data/yuno.db
LOG_LEVEL=INFO
SEED_OFFLINE_DEMO=false
